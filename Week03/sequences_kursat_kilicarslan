def remove_duplicates(seq: list) -> list:
    new_list = list()
    for i in seq:
        if i not in new_list:
            new_list.append(i)
    return new_list

def list_counts(seq: list) -> dict:
    new_dict = dict()
    for i in seq:
        if i not in new_dict:
            new_dict[i] = 1
        else:
            new_dict[i] += 1
    return new_dict

def reverse_dict(d: dict) -> dict:
    new_dict = dict()
    for key, value in d.items():
        new_dict[value] = key
    return new_dict
